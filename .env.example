# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=4040
# Puerta de enlace de docker0: el host visto desde los contenedores.
# NO 127.0.0.1 si Caddy corre en un contenedor: no llegaría.
HOST=172.17.0.1
# La URL pública, para las meta etiquetas (detrás de Caddy llega por http).
PUBLIC_BASE_URL=https://segovia.ultrak.dynu.net

# ── Modo por defecto ──────────────────────────────────────────────────────────
# redirect: 302 a la URL directa de Microsoft (no pasa ni un byte por aquí).
# proxy: los bytes pasan por este servidor, con Range e inline.
# Cada enlace puede elegir con ?m=redirect o ?m=proxy.
DEFAULT_MODE=redirect

# ── Subida a OneDrive (opcional) ──────────────────────────────────────────────
# Sin esto, la landing no muestra la pestaña de subir. Es el «Id. de aplicación
# (cliente)» de la app de Entra (ver README); no es secreto: va al navegador.
ONEDRIVE_CLIENT_ID=
# El relevo de Cloudflare para cuando la subida directa va lenta: la ruta
# /relay del Worker. Sin esto, todo va directo.
RELAY_URL=https://segovia.ultrak.workers.dev/relay
